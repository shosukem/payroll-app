# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_PORT=1433

# 認証方式: "entra-id" (Entra ID / Azure AD) もしくは "sql" (SQL Server認証)
AZURE_SQL_AUTH_TYPE=sql

# SQL認証の場合: ローカルSQLユーザー (例: sqladmin)
# Entra IDの場合: メールアドレス (例: user@example.com)
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=your-password

# Entra ID認証の場合のみ必要 (テナントドメイン or テナントID)
AZURE_SQL_TENANT_ID=

# DB初期化用シークレット
DB_INIT_SECRET=your-init-secret

# Azure Blob Storage (従業員添付ファイル保存用)
# 本番(App Service)ではマネージドID + AZURE_STORAGE_ACCOUNT を使用
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=employee-files

# ローカル開発用(任意): 接続文字列で直接認証する場合に設定
# 設定すると AZURE_STORAGE_ACCOUNT より優先される
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
